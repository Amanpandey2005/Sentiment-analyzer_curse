APP_NAME=ML Sentiment Analysis Platform
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://sentiment:sentiment@postgres:5432/sentiment
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret
API_RATE_LIMIT_PER_MINUTE=120
MODEL_PATH=ml/saved_models/sentiment_model.joblib
TRAINING_DATA_PATH=data/sample_reviews.csv
API_URL=http://api:8000
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY=sentiment-platform
EC2_HOST=ec2-0-0-0-0.compute-1.amazonaws.com
EC2_USER=ubuntu
S3_MODEL_BUCKET=sentiment-platform-model-artifacts
CLOUDWATCH_LOG_GROUP=/ml-sentiment-platform/api
